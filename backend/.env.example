PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
# Optional comma-separated DNS resolver addresses for Node.js SRV lookup.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
MONGODB_DB=tribull
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=7d
# Primary admin login allowlist. The existing authorized account may be in either collection.
# This does not grant an admin role; the record must have a bcrypt hash and active admin grant.
ADMIN_LOGIN_EMAIL=your-existing-admin@example.com
# Optional additional allowlist for a non-dedicated admin-datas account.
ADMIN_TEST_EMAIL=your-test-admin@example.com
ADMIN_TEST_PASSWORD=replace-with-a-unique-secret
# Use none for cross-site HTTPS frontend/API deployments (for example Vercel and Render).
AUTH_COOKIE_SAME_SITE=lax
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Comma-separated allowed frontend origins; add the deployed Vercel origin in production.
FRONTEND_URL=http://localhost:3001
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_character_app_password
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-webhook-secret

# Local-only Super Admin test account setup (never use these settings in production).
# Run admin:test-account from a PowerShell session with the matching variables set.
# NODE_ENV=development
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=tribull_local
# ADMIN_TEST_EMAIL=local-test-admin@example.test
# ADMIN_TEST_PASSWORD=replace-with-a-unique-local-password
# ADMIN_LOGIN_EMAIL=local-test-admin@example.test

# Atlas-backed testing admin (the setup command requires explicit account-email confirmation).
# ADMIN_TEST_EMAIL=testing-admin@example.test
# ADMIN_TEST_PASSWORD=replace-with-a-unique-local-password
# ADMIN_TEST_NAME=Testing Super Admin
# ADMIN_LOGIN_EMAIL=existing-regular-admin@example.test
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
# MONGODB_DB=<database>
